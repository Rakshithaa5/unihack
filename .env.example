# ProvenIQ — environment variables
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# Groq API key — free tier at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: free-tier web search API key
# DuckDuckGo (duckduckgo-search library) requires no key.
# If you prefer a different provider, add its key here:
# SERPER_API_KEY=your_serper_api_key_here

# Confidence threshold below which fields are routed to the HITL queue
HITL_CONFIDENCE_THRESHOLD=0.6

# SQLite database file path (relative to project root)
KG_DB_PATH=data/knowledge_graph.db

# Chroma vector store directory
CHROMA_PERSIST_DIR=data/chroma_store

# FastAPI backend port
BACKEND_PORT=8000
